@article{Godar2016,
  author = {Godar, Javier and Suavet, Cl\'{e}ment and Gardner, Toby A. and Dawkins, Elena and Meyfroidt, Patrick},
  title = {Balancing detail and scale in assessing transparency to improve the governance of agricultural commodity supply chains},
  journal = {Environmental Research Letters},
  volume = {11},
  number = {3},
  pages = {035015},
  year = {2016},
  month = {3},
  publisher = {IOP Publishing Ltd},
  doi = {10.1088/1748-9326/11/3/035015},
  url = {https://iopscience.iop.org/article/10.1088/1748-9326/11/3/035015},
  note = {Focus on Food, Trade and the Environment},
  abstract = {To date, assessments of the sustainability of agricultural commodity supply chains have largely relied on some combination of macro-scale footprint accounts, detailed local case studies, and selected certification schemes. Yet these approaches are unable to support the whole-sale transformation towards sustainability that is so urgently needed. Here we present a new approach—SEI-PCS (Spatially Explicit Information on Production to Consumption Systems)—to mapping the flows of agricultural commodities from production landscapes to consumer markets. This approach is a prerequisite for understanding the sustainability of commodity production systems and the possible interventions to improve them. We illustrate the potential of this approach with the case of Brazilian soy exports. We use the SEI-PCS model to link municipalities of production in Brazil to countries of consumption, via an analysis of international trade flows and domestic allocation of soy to sectors and uses, including the transformation and transportation of embedded soy products. This approach highlights the complexity of intercontinental commodity supply chains, with the link between a specific point of production and a final consumer being potentially composed of many processes and actors. The approach also enables a deeper understanding of the roles played by consumer markets and intermediary actors such as traders and retailers in shaping soy production systems. Applications of this approach include: identifying specific actors that could contribute to a more sustainable supply chain; distinguishing different types of production systems and their impacts; and assessing the market exposure of different supply chain actors to unsustainable production practices.},
  keywords = {supply chains, commodity flows, transparency, governance, sustainability, Brazil, soy},
  issn = {1748-9326},
  openaccess = {true}
}

