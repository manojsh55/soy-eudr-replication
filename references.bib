@article{baier2019,
  title = {On the widely differing effects of free trade agreements: Lessons from twenty years of trade integration},
  author = {Baier, Scott L. and Yotov, Yoto V. and Zylkin, Thomas},
  journal = {Journal of International Economics},
  volume = {116},
  pages = {206--226},
  year = {2019},
  doi = {10.1016/j.jinteco.2018.11.002},
  issn = {0022-1996},
  publisher = {Elsevier},
  abstract = {We develop a novel two-stage methodology that allows us to study the empirical determinants of the heterogeneous effects of free trade agreements (FTAs). First, we identify the effects of specific FTAs on bilateral trade by estimating a structural gravity model with multiple FTAs. Second, we use the estimated FTA effects as the dependent variable in a cross-sectional regression to examine how FTA, country, and country-pair characteristics affect the impact of FTAs on trade. We find that FTAs with deeper integration increase trade more and that the effects of FTAs are larger when member countries are less developed.},
  keywords = {Free trade agreements, Heterogeneous effects, Structural gravity, Trade integration}
}

@article{allen2020,
  title = {Universal Gravity},
  author = {Allen, Treb and Arkolakis, Costas and Takahashi, Yuta},
  journal = {Journal of Political Economy},
  volume = {128},
  number = {2},
  pages = {393--433},
  year = {2020},
  month = {February},
  doi = {10.1086/704385},
  publisher = {University of Chicago Press},
  issn = {0022-3808},
  url = {https://www.journals.uchicago.edu/doi/10.1086/704385},
  abstract = {We show that a large class of spatial models featuring many regions, labor mobility, and both agglomeration and congestion forces—a class that contains most models in the quantitative spatial literature—isomorphically map into a simple, universal, gravity equation. We use this framework to estimate the underlying parameters of these models and to perform counterfactuals for a class of place-based policies. We find that agglomeration forces are larger than congestion forces, leading to the existence of multiple equilibria. Nevertheless, the counterfactual predictions are remarkably similar across the class of models we consider.}
}

