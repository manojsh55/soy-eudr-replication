@article{bohringer2017,
    title={Robust policies to mitigate carbon leakage},
    author={B{\"o}hringer, Christoph and Rosendahl, Knut Einar and Storr{\o}sten, Halvor Briseid},
    journal={Journal of Public Economics},
    volume={149},
    pages={35--46},
    year={2017},
    month={May},
    publisher={Elsevier},
    doi={10.1016/j.jpubeco.2017.03.006},
    abstract={Unilateral climate policy induces carbon leakage through the relocation of emission-intensive and trade-exposed industries to regions with no or more lenient emission regulation. Both analytical and numerical studies suggest that emission pricing combined with border carbon adjustment (BCA) can effectively reduce carbon leakage. We demonstrate that these results hinge on the implicit assumption that the regulating region can determine the carbon intensity of foreign production. We show analytically that the effectiveness of BCA depends crucially on the foreign carbon intensity used to calculate the border adjustments. The effectiveness decreases substantially if the foreign carbon intensity is underestimated. If the regulating region cannot properly assess the carbon intensity of foreign production and therefore bases adjustments on domestic carbon intensities, leakage rates are even higher than with emission pricing only. We complement our analytical results with numerical simulations based on empirical data.},
    keywords={Carbon leakage, Border carbon adjustment, Climate policy design},
    issn={0047-2727}
}

@techreport{mahlkow2023,
    title={The Carbon Footprint of Global Trade Imbalances},
    author={Mahlkow, Hendrik and Wanner, Joschka},
    year={2023},
    type={Working Paper},
    number={10729},
    institution={CESifo},
    month={October},
    doi={10.2139/ssrn.4622025},
    abstract={We quantify the contribution of global trade imbalances to countries' carbon footprints. Trade deficits allow countries to consume more than they produce, affecting not only their economic footprint but also their carbon footprint. We show in a multi-sector, multi-country general equilibrium model that trade imbalances affect carbon footprints through changes in the scale and composition of consumption and production. Empirically, we find that trade deficit countries have 12% larger carbon footprints and 5% lower territorial emissions than in a counterfactual world without trade imbalances. For surplus countries, the effects are reversed. These effects are driven by both the scale effect of higher consumption and production levels and the composition effect of a shift towards more carbon-intensive goods in deficit countries.},
    keywords={Carbon Footprint, Trade Imbalances, Climate Change, International Trade},
    note={CESifo Working Paper Series}
}

