  publisher = {Elsevier},
  abstract = {We seek to estimate the effect of changes in crop prices on deforestation in the tropics. We combine various datasets for the tropical regions at the spatial resolution of 0.5-degree latitude and longitude grid cells for the period 2001–2018. We find that crop price variation has a significant impact on deforestation: increases in crop prices are estimated to be responsible for one-third of total deforestation in the Tropics (totaling about 2 million km²).}
